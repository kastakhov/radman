# http port
server.port=8089

# radius database
database.radius.datasource.url=jdbc:mariadb://[server-address-here]:3306/[db-name-here]?serverTimezone=UTC
database.radius.datasource.username=[username-here]
database.radius.datasource.password=[password-here]
database.radius.datasource.test-while-idle=true
database.radius.datasource.validation-query=/* ping */
database.radius.datasource.driver-class-name=org.mariadb.jdbc.Driver
database.radius.jpa.show-sql=false
database.radius.jpa.hibernate.ddl-auto=validate

# internal database
database.radman.datasource.url=jdbc:mariadb://[server-address-here]:3306/[db-name-here]?serverTimezone=UTC
database.radman.datasource.username=[username-here]
database.radman.datasource.password=[password-here]
database.radman.datasource.test-while-idle=true
database.radman.datasource.validation-query=/* ping */
database.radman.datasource.driver-class-name=org.mariadb.jdbc.Driver
database.radman.jpa.show-sql=false
database.radman.jpa.hibernate.ddl-auto=validate

# liquibase
database.radman.liquibase.enabled=true
database.radman.liquibase.change-log=classpath:db/changelog/mysql/db.changelog-master.xml
database.radman.liquibase.check-change-log-location=true

# ldap
ldap.enabled=false
ldap.urls=ldap://[server-address-here]:389/
ldap.managerDn=[dn-for-manager-account-here]
ldap.managerPassword=[password-for-manager-account-here]
ldap.search-base-dn=[base-search-dn-here]
ldap.user-search-filter=(uid={0})

# logging
logging.file=/var/log/radman
logging.level.root=WARN
logging.level.org.springframework.boot=INFO
logging.level.software.netcore.radman=INFO

# component settings
vaadin.productionMode=true
spring.jpa.open-in-view=false

# security auto-login (WARNING: Only use in development/testing - disables login page and logs in as admin)
security.auto-login.enabled=false
security.auto-login.username=auto-admin
